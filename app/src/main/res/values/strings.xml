    <!--
      Custom voice vocabulary. These phrases are deliberately uncommon so
      Google Assistant does NOT short-circuit them with its own torch /
      volume / DND handlers. The user still says "in QuickControls" at the
      end so Assistant routes through App Actions to us.
    -->
    <string-array name="torch_on_synonyms">
        <item>torch_on</item><item>light up the window</item><item>open the window</item>
        <item>lantern on</item><item>ignite the torch</item><item>fire up the lamp</item>
    </string-array>
    <string-array name="torch_off_synonyms">
        <item>torch_off</item><item>shut the window</item><item>close the window</item>
        <item>lantern off</item><item>kill the lamp</item><item>douse the torch</item>
    </string-array>

